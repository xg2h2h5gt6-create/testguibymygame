local VirtualUser = game:GetService("VirtualUser")
local TweenService = game:GetService("TweenService")
local UserInputService = game:GetService("UserInputService")

-- // Boss Konumu Sabit //
local BOSS_POSITION = Vector3.new(-1824, 3, 1945) -- Senin copypos'un
local BOSS_WAIT_TIME = 300 -- 5 dakika (saniye)
local KNOCKBACK_DISTANCE = 50 -- 50 stud'dan fazla uzaklaşırsa geri ışınla

-- // Ana GUI //
local ScreenGui = Instance.new("ScreenGui")
ScreenGui.Name = "ZwacHub"
ScreenGui.Parent = game:GetService("CoreGui")

if syn and syn.protect_gui then
    syn.protect_gui(ScreenGui)
end

-- // Renk Paleti //
local C = {
    BG = Color3.fromRGB(18, 18, 20),
    Frame = Color3.fromRGB(28, 28, 32),
    Accent = Color3.fromRGB(220, 220, 230),
    Text = Color3.fromRGB(240, 240, 250),
    TextDim = Color3.fromRGB(150, 150, 160),
    TabActive = Color3.fromRGB(220, 220, 230),
    TabInactive = Color3.fromRGB(60, 60, 65),
    SwitchOn = Color3.fromRGB(220, 220, 230),
    SwitchOff = Color3.fromRGB(50, 50, 55)
}

-- // Yardımcı //
local function Tween(obj, props, dur)
    return TweenService:Create(obj, TweenInfo.new(dur or 0.2, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), props):Play()
end

-- // Sürükleme Sistemi //
local function MakeDraggable(frame, handle)
    local drag, start, pos = false, nil, nil
    handle = handle or frame
    handle.InputBegan:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
            drag, start, pos = true, input.Position, frame.Position
        end
    end)
    handle.InputChanged:Connect(function(input)
        if drag and (input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch) then
            local delta = input.Position - start
            frame.Position = UDim2.new(pos.X.Scale, pos.X.Offset + delta.X, pos.Y.Scale, pos.Y.Offset + delta.Y)
        end
    end)
    UserInputService.InputEnded:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
            drag = false
        end
    end)
end

