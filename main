-- ==================== PATH WALKER ====================
AddSection(PathTab, "Konum Yönetimi")
local pathLabel = AddLabel(PathTab, "Kaydedilen Konum: 0")

local waypoints = {}
local markers = {}
local markersVisible = false
local walkActive = false
local quickRecordButton = nil

local function createMarkers()
    for _, marker in pairs(markers) do
        pcall(function() marker:Destroy() end)
    end
    markers = {}
    if not markersVisible then return end

    local base = workspace:FindFirstChild("Terrain") or workspace:FindFirstChild("Baseplate") or workspace

    for i, pos in ipairs(waypoints) do
        local attachment = Instance.new("Attachment")
        attachment.Position = pos
        attachment.Parent = base
        markers[#markers + 1] = attachment

        local billboard = Instance.new("BillboardGui")
        billboard.Size = UDim2.new(0, 80, 0, 80)
        billboard.AlwaysOnTop = true
        billboard.StudsOffset = Vector3.new(0, 0.1, 0)
        billboard.MaxDistance = 300
        billboard.Adornee = attachment
        billboard.Parent = attachment

        local circle = Instance.new("Frame")
        circle.Size = UDim2.new(0, 60, 0, 60)
        circle.Position = UDim2.new(0.5, -30, 0.5, -30)
        circle.BackgroundColor3 = C.MarkerColor
        circle.BackgroundTransparency = 0.2
        circle.BorderSizePixel = 0
        circle.Parent = billboard

        local uiCorner = Instance.new("UICorner")
        uiCorner.CornerRadius = UDim.new(1, 0)
        uiCorner.Parent = circle

        local numberLabel = Instance.new("TextLabel")
        numberLabel.Size = UDim2.new(1, 0, 1, 0)
        numberLabel.BackgroundTransparency = 1
        numberLabel.Text = tostring(i)
        numberLabel.TextColor3 = Color3.fromRGB(255, 255, 255)
        numberLabel.TextSize = 24
        numberLabel.Font = Enum.Font.GothamBold
        numberLabel.Parent = circle

        markers[#markers + 1] = billboard
    end
end

local function walkTo(targetPos)
    local char = Player.Character
    if not char then return false end
    local humanoid = char:FindFirstChild("Humanoid")
    if not humanoid then return false end

    humanoid:MoveTo(targetPos)
    local arrived = false
    local connection = humanoid.MoveToFinished:Connect(function(reached)
        if reached then arrived = true end
    end)

    local timeout = 30
    local startTime = tick()
    while not arrived and walkActive and (tick() - startTime) < timeout do
        if char:FindFirstChild("HumanoidRootPart") and (char.HumanoidRootPart.Position - targetPos).Magnitude < 2 then
            arrived = true
        end
        task.wait(0.1)
    end
    if connection then connection:Disconnect() end
    return arrived
end

local function parseWaitTime(input)
    local text = input:gsub("%s", "")
    if text == "" or text == "0" then return 0 end
    local minutes, seconds = text:match("^(%d+):(%d+)$")
    if minutes and seconds then return tonumber(minutes) * 60 + tonumber(seconds) end
    local number = tonumber(text)
    if number then return number * 60 end
    return 0
end

local function saveWaypoint()
    if Player.Character and Player.Character:FindFirstChild("HumanoidRootPart") then
        local pos = Player.Character.HumanoidRootPart.Position
        waypoints[#waypoints + 1] = pos
        pathLabel.Text = "Kaydedilen Konum: " .. #waypoints
        if markersVisible then createMarkers() end
    end
end

AddButton(PathTab, "Konum Kaydet", saveWaypoint)

AddButton(PathTab, "Tümünü Temizle", function()
    waypoints = {}
    pathLabel.Text = "Kaydedilen Konum: 0"
    if walkActive then walkActive = false end
    for _, marker in pairs(markers) do
        pcall(function() marker:Destroy() end)
    end
    markers = {}
end)

local markerToggle = AddToggle(PathTab, "Konum İşaretleri", "2D mor daireler", false)
markerToggle:OnChanged(function(val)
    markersVisible = val
    if val then createMarkers() end
end)

local quickRecordToggle = AddToggle(PathTab, "Hızlı Kayıt Butonu", "Ekranda sürüklenebilir buton", false)
quickRecordToggle:OnChanged(function(val)
    if val then
        if not quickRecordButton then
            quickRecordButton = Instance.new("TextButton")
            quickRecordButton.Size = UDim2.new(0, 50, 0, 50)
            quickRecordButton.Position = UDim2.new(0.8, 0, 0.5, 0)
            quickRecordButton.BackgroundColor3 = Color3.fromRGB(139, 69, 255)
            quickRecordButton.BackgroundTransparency = 0.3
            quickRecordButton.BorderSizePixel = 0
            quickRecordButton.Text = "📍"
            quickRecordButton.TextColor3 = Color3.fromRGB(255, 255, 255)
            quickRecordButton.TextSize = 24
            quickRecordButton.Font = Enum.Font.GothamBold
            quickRecordButton.Parent = ScreenGui

            local corner = Instance.new("UICorner")
            corner.CornerRadius = UDim.new(1, 0)
            corner.Parent = quickRecordButton

            MakeDraggable(quickRecordButton)
            quickRecordButton.MouseButton1Click:Connect(saveWaypoint)
        end
        quickRecordButton.Visible = true
    else
        if quickRecordButton then quickRecordButton.Visible = false end
    end
end)

AddSection(PathTab, "Yürüme Ayarları")
local waitTimeInput = AddTextBox(PathTab, "örn: 01:00 veya 1 (dakika)", "0")

AddButton(PathTab, "Yürümeye Başla", function()
    if #waypoints == 0 then
        pathLabel.Text = "Önce konum kaydet!"
        return
    end
    if walkActive then return end
    walkActive = true
    task.spawn(function()
        while walkActive do
            for i, targetPos in ipairs(waypoints) do
                if not walkActive then break end
                pathLabel.Text = "Gidiliyor: " .. i .. "/" .. #waypoints
                local success = pcall(walkTo, targetPos)
                if not walkActive then break end
                if success then
                    local waitSeconds = parseWaitTime(waitTimeInput:GetText())
                    if waitSeconds > 0 then
                        local waited = 0
                        while waited < waitSeconds and walkActive do
                            task.wait(1)
                            waited = waited + 1
                            pathLabel.Text = "Bekleniyor: " .. (waitSeconds - waited) .. "s"
                        end
                    end
                end
            end
            if walkActive then
                pathLabel.Text = "Döngü tamamlandı"
                task.wait(1)
            end
        end
        pathLabel.Text = "Kaydedilen Konum: " .. #waypoints .. " (durduruldu)"
    end)
end)

AddButton(PathTab, "Durdur", function()
    walkActive = false
    pathLabel.Text = "Kaydedilen Konum: " .. #waypoints .. " (durduruldu)"
end)

-- ==================== MULTI CLICKER ====================
AddSection(MultiClickerTab, "Tıklama Noktaları")
local clickerLabel = AddLabel(MultiClickerTab, "Kaydedilen Nokta: 0")

local clickPoints = {}
local clickerActive = false

local function createClickerMarkers()
    for _, data in ipairs(clickPoints) do
        if data.label then
            pcall(function() data.label:Destroy() end)
        end
    end

    for i, data in ipairs(clickPoints) do
        local label = Instance.new("BillboardGui")
        label.Size = UDim2.new(0, 60, 0, 60)
        label.AlwaysOnTop = true
        label.Parent = ScreenGui

        local circle = Instance.new("Frame")
        circle.Size = UDim2.new(0, 50, 0, 50)
        circle.Position = data.position - Vector2.new(25, 25)
        circle.BackgroundColor3 = C.ClickerColor
        circle.BackgroundTransparency = 0.3
        circle.BorderSizePixel = 0
        circle.Parent = label

        local uiCorner = Instance.new("UICorner")
        uiCorner.CornerRadius = UDim.new(1, 0)
        uiCorner.Parent = circle

        local numberLabel = Instance.new("TextLabel")
        numberLabel.Size = UDim2.new(1, 0, 1, 0)
        numberLabel.BackgroundTransparency = 1
        numberLabel.Text = tostring(i)
        numberLabel.TextColor3 = Color3.fromRGB(255, 255, 255)
        numberLabel.TextSize = 24
        numberLabel.Font = Enum.Font.GothamBold
        numberLabel.Parent = circle

        data.label = label
    end
end

local function addClickPoint()
    local mousePos = UserInputService:GetMouseLocation()
    clickPoints[#clickPoints + 1] = {position = mousePos, label = nil}
    clickerLabel.Text = "Kaydedilen Nokta: " .. #clickPoints
    createClickerMarkers()
end

local function clearClickPoints()
    for _, data in ipairs(clickPoints) do
        if data.label then
            pcall(function() data.label:Destroy() end)
        end
    end
    clickPoints = {}
    clickerLabel.Text = "Kaydedilen Nokta: 0"
    if clickerActive then
        clickerActive = false
        clickerLabel.Text = "Kaydedilen Nokta: 0 (durduruldu)"
    end
end

AddButton(MultiClickerTab, "Nokta Ekle (Mouse Konumu)", addClickPoint)
AddButton(MultiClickerTab, "Tümünü Temizle", clearClickPoints)

AddSection(MultiClickerTab, "Tıklama Ayarları")
local clickerDelayInput = AddTextBox(MultiClickerTab, "örn: 00:01 (1 saniye)", "00:01")

local function parseClickDelay(input)
    local text = input:gsub("%s", "")
    if text == "" then return 1 end
    local minutes, seconds = text:match("^(%d+):(%d+)$")
    if minutes and seconds then
        return math.max(0.01, tonumber(minutes) * 60 + tonumber(seconds))
    end
    local number = tonumber(text)
    if number then return math.max(0.01, number) end
    return 1
end

local function fireClick(x, y)
    pcall(function()
        mouse1press(x, y)
        task.wait(0.05)
        mouse1release(x, y)
    end)
end

local clickerStatusLabel = AddLabel(MultiClickerTab, "Durum: Pasif")

AddButton(MultiClickerTab, "Tıklamaya Başla", function()
    if #clickPoints == 0 then
        clickerStatusLabel.Text = "Durum: Önce nokta ekle!"
        return
    end
    if clickerActive then return end
    clickerActive = true
    clickerStatusLabel.Text = "Durum: Aktif"
    task.spawn(function()
        while clickerActive do
            for i, data in ipairs(clickPoints) do
                if not clickerActive then break end
                fireClick(data.position.X, data.position.Y)
                local delay = parseClickDelay(clickerDelayInput:GetText())
                task.wait(delay)
            end
        end
    end)
end)

AddButton(MultiClickerTab, "Durdur", function()
    clickerActive = false
    clickerStatusLabel.Text = "Durum: Durduruldu"
end)

-- ==================== AUTO CLICKER ====================
AddSection(AutoClickerTab, "Hızlı Tıklama Noktası")
local autoClickerLabel = AddLabel(AutoClickerTab, "Konum: Ayarlanmadı")

local autoClickPos = nil
local autoClickMarker = nil
local autoClickerActive = false

local function updateAutoClickMarker()
    if autoClickMarker then
        pcall(function() autoClickMarker:Destroy() end)
        autoClickMarker = nil
    end
    if not autoClickPos then return end

    local label = Instance.new("BillboardGui")
    label.Size = UDim2.new(0, 60, 0, 60)
    label.AlwaysOnTop = true
    label.Parent = ScreenGui

    local circle = Instance.new("Frame")
    circle.Size = UDim2.new(0, 50, 0, 50)
    circle.Position = autoClickPos - Vector2.new(25, 25)
    circle.BackgroundColor3 = C.AutoClickerColor
    circle.BackgroundTransparency = 0.3
    circle.BorderSizePixel = 0
    circle.Parent = label

    local uiCorner = Instance.new("UICorner")
    uiCorner.CornerRadius = UDim.new(1, 0)
    uiCorner.Parent = circle

    local iconLabel = Instance.new("TextLabel")
    iconLabel.Size = UDim2.new(1, 0, 1, 0)
    iconLabel.BackgroundTransparency = 1
    iconLabel.Text = "⚡"
    iconLabel.TextColor3 = Color3.fromRGB(255, 255, 255)
    iconLabel.TextSize = 24
    iconLabel.Font = Enum.Font.GothamBold
    iconLabel.Parent = circle

    autoClickMarker = label
end

AddButton(AutoClickerTab, "Konum İşaretle (Mouse)", function()
    autoClickPos = UserInputService:GetMouseLocation()
    autoClickerLabel.Text = "Konum: " .. math.floor(autoClickPos.X) .. ", " .. math.floor(autoClickPos.Y)
    updateAutoClickMarker()
end)

AddSection(AutoClickerTab, "Hız Ayarı (CPS)")
local cpsInput = AddTextBox(AutoClickerTab, "Saniyede tıklama (örn: 10)", "10")

local function getCPSDelay()
    local cps = tonumber(cpsInput:GetText())
    if not cps or cps <= 0 then cps = 10 end
    return 1 / cps
end

local autoClickStatusLabel = AddLabel(AutoClickerTab, "Durum: Pasif")

local autoClickToggle = AddToggle(AutoClickerTab, "Auto Clicker", "Tek noktaya sürekli hızlı tıklar", false)
autoClickToggle:OnChanged(function(val)
    autoClickerActive = val
    if val then
        if not autoClickPos then
            autoClickToggle:SetState(false)
            autoClickStatusLabel.Text = "Durum: Önce konum işaretle!"
            return
        end
        autoClickStatusLabel.Text = "Durum: Aktif - CPS: " .. (cpsInput:GetText() or "10")
        task.spawn(function()
            while autoClickerActive do
                if autoClickPos then
                    fireClick(autoClickPos.X, autoClickPos.Y)
                end
                task.wait(getCPSDelay())
            end
        end)
    else
        autoClickStatusLabel.Text = "Durum: Durduruldu"
    end
end)

-- ==================== SOCIAL ====================
AddSection(SocialTab, "Arkadaşlık")
local friendLabel = AddLabel(SocialTab, "Durum: Pasif")
local sentFriends = {}
local friendActive = false
local friendConnection = nil

local function sendFriendRequests()
    local success = 0
    for _, targetPlayer in pairs(Players:GetPlayers()) do
        if targetPlayer ~= Player and not sentFriends[targetPlayer.UserId] then
            pcall(function()
                Players:RequestFriendship(targetPlayer.UserId)
                sentFriends[targetPlayer.UserId] = true
                success = success + 1
            end)
            task.wait(1)
        end
    end
    friendLabel.Text = "Durum: " .. success .. " istek atıldı"
end

local autoFriendToggle = AddToggle(SocialTab, "Auto Friend", "Herkese otomatik arkadaşlık isteği atar", false)
autoFriendToggle:OnChanged(function(val)
    friendActive = val
    if val then
        friendLabel.Text = "Durum: Aktif - İstekler atılıyor..."
        task.spawn(sendFriendRequests)
        friendConnection = Players.PlayerAdded:Connect(function(newPlayer)
            if friendActive and newPlayer ~= Player and not sentFriends[newPlayer.UserId] then
                task.wait(2)
                pcall(function()
                    Players:RequestFriendship(newPlayer.UserId)
                    sentFriends[newPlayer.UserId] = true
                end)
                friendLabel.Text = "Durum: Yeni oyuncuya istek atıldı: " .. newPlayer.Name
            end
        end)
    else
        if friendConnection then
            friendConnection:Disconnect()
            friendConnection = nil
        end
        friendLabel.Text = "Durum: Durduruldu"
    end
end)

for _, tab in pairs(tabs) do
    task.wait(0.05)
    tab.content.CanvasSize = UDim2.new(0, 0, 0, tab.list.AbsoluteContentSize.Y + 40)
end

Main.Size = UDim2.new(0, 500, 0, 0)
Main.Visible = true
Tween(Main, {Size = UDim2.new(0, 500, 0, 460)}, 0.3)
task.wait(0.3)
Main.Visible = false

