    Main.Visible = not Main.Visible
end)

Close.MouseButton1Click:Connect(function()
    Main.Visible = false
end)

-- // ==================== SEKMELER ==================== //
local GameTab = CreateTab("Game", "🎮")
local SettingsTab = CreateTab("Settings", "⚙️")

-- // --- GAME SEKME --- //
AddSection(GameTab, "Dungeon Otomasyonu")
local autoReplay = AddToggle(GameTab, "Auto Replay", "Her 10 saniyede bir Replay eventini atar", false)

autoReplay:OnChanged(function(val)
    if val then
        task.spawn(function()
            while autoReplay:GetState() do
                pcall(function()
                    local args = { [1] = "sponsor" }
                    game:GetService("ReplicatedStorage").Remotes.DungeonWaveReplayVote:FireServer(unpack(args))
                end)
                task.wait(10)
            end
        end)
    end
end)

-- // --- BOSS TIMER --- //
AddSection(GameTab, "Boss Timer")

AddLabel(GameTab, "Süre (dakika:saniye)")

local bossTimeInput = AddTextBox(GameTab, "örn: 29:03", "30:00")

local bossTimerToggle = AddToggle(GameTab, "Boss Farm", "Belirtilen sürede bir boss'a ışınlanır", false)
local bossStatus = AddLabel(GameTab, "⏳ Bekliyor...")
bossStatus.Size = UDim2.new(1, 0, 0, 20)

-- Boss Timer Değişkenleri
local bossTimerActive = false
local bossTimerThread = nil
local savedPosition = nil

-- Süre ayrıştırma fonksiyonu
local function parseTime(input)
    local minutes, seconds = input:match("(%d+):(%d+)")
    if minutes and seconds then
        return tonumber(minutes) * 60 + tonumber(seconds)
    end
    return nil
end

-- Boss Timer Ana Döngü
bossTimerToggle:OnChanged(function(val)
    bossTimerActive = val
    
    if val then
        -- Mevcut konumu kaydet
        local char = Player.Character
        if char and char:FindFirstChild("HumanoidRootPart") then
            savedPosition = char.HumanoidRootPart.Position
            bossStatus.Text = "📍 Konum kaydedildi: " .. math.floor(savedPosition.X) .. ", " .. math.floor(savedPosition.Y) .. ", " .. math.floor(savedPosition.Z)
        else
            bossStatus.Text = "❌ Karakter bulunamadı!"
            bossTimerToggle.SetState(false)
            return
        end
        
        bossTimerThread = task.spawn(function()
            while bossTimerActive do
                -- Süreyi al ve hesapla
                local inputTime = bossTimeInput.GetText()
                local waitTime = parseTime(inputTime)
                
                if not waitTime then
                    bossStatus.Text = "⚠️ Geçersiz format! (dakika:saniye)"
                    bossTimerActive = false
                    bossTimerToggle.SetState(false)
                    break
                end
                
                bossStatus.Text = "⏳ " .. inputTime .. " bekleniyor..."
                
                -- Bekleme süresi
                local elapsed = 0
                while elapsed < waitTime and bossTimerActive do
                    task.wait(1)
                    elapsed = elapsed + 1
                    bossStatus.Text = "⏳ " .. inputTime .. " | Kalan: " .. (waitTime - elapsed) .. "s"
                end
                
                if not bossTimerActive then break end
                
                -- Boss konumuna ışınlanma
                bossStatus.Text = "⚡ Boss'a ışınlanıyor..."
                if char and char:FindFirstChild("HumanoidRootPart") then
                    char.HumanoidRootPart.CFrame = CFrame.new(BOSS_POSITION)
                end
                
                -- Boss alanında 5 dakika bekleme (knockback kontrolü ile)
                local bossStartTime = tick()
                local bossEndTime = bossStartTime + BOSS_WAIT_TIME
                
                while tick() < bossEndTime and bossTimerActive do
                    task.wait(0.5)
                    
                    -- Knockback kontrolü
                    if char and char:FindFirstChild("HumanoidRootPart") then
                        local currentPos = char.HumanoidRootPart.Position
                        local distance = (currentPos - BOSS_POSITION).Magnitude
                        
                        if distance > KNOCKBACK_DISTANCE then
                            pcall(function()
                                char.HumanoidRootPart.CFrame = CFrame.new(BOSS_POSITION)
                            end)
                            bossStatus.Text = "🔄 Knockback alındı, geri ışınlandı!"
                        else
                            local remaining = math.floor(bossEndTime - tick())
                            bossStatus.Text = "⚔️ Boss kesiliyor | Kalan: " .. remaining .. "s"
                        end
                    end
                end
                
                if not bossTimerActive then break end
                
                -- Eski konuma geri dön
                bossStatus.Text = "↩️ Geri dönülüyor..."
                if char and char:FindFirstChild("HumanoidRootPart") and savedPosition then
                    char.HumanoidRootPart.CFrame = CFrame.new(savedPosition)
                end
                
                bossStatus.Text = "✅ Döngü tamamlandı, sıradaki bekleniyor..."
            end
        end)
    else
        if bossTimerThread then
            bossTimerThread = nil
        end
        bossStatus.Text = "⏸️ Durduruldu"
    end
end)

-- // --- SETTINGS SEKME --- //
AddSection(SettingsTab, "Genel")
local antiAFK = AddToggle(SettingsTab, "Anti AFK", "Karakteri kıpırdatmadan AFK engeller", false)

task.spawn(function()
    while task.wait(10) do
        if antiAFK:GetState() then
            pcall(function()
                VirtualUser:CaptureController()
                VirtualUser:ClickButton2(Vector2.new())
            end)
        end
    end
end)

AddSection(SettingsTab, "Performans")
local fpsBoost = AddToggle(SettingsTab, "FPS Boost", "Gereksiz textureları temizler", false)

fpsBoost:OnChanged(function(val)
    if val then
        for _, v in pairs(workspace:GetDescendants()) do
            if v:IsA("Texture") or v:IsA("Decal") then
                pcall(function() v:Destroy() end)
            end
        end
        game:GetService("Lighting").GlobalShadows = false
        game:GetService("Lighting").FogEnd = 9e9
        pcall(function() settings().Rendering.QualityLevel = 1 end)
    end
end)

AddSection(SettingsTab, "Optimizasyon")
AddLabel(SettingsTab, "⚡ Ayarlar otomatik kaydedilmez")

-- // Canvas Güncelle //
for _, tab in pairs(tabs) do
    task.wait(0.05)
    tab.content.CanvasSize = UDim2.new(0, 0, 0, tab.list.AbsoluteContentSize.Y + 20)
end

-- // Açılış Animasyonu //
Main.Size = UDim2.new(0, 500, 0, 0)
Main.Visible = true
Tween(Main, {Size = UDim2.new(0, 500, 0, 350)}, 0.3)
task.wait(0.3)
Main.Visible = false

print("✅ ZwacHub v2.1 Yüklendi - Boss Timer Eklendi")
print("🎮 Geliştirici: Zwac | %100 Organik Kod")
print("📍 Boss Konumu: " .. tostring(BOSS_POSITION))
