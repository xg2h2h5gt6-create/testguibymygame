-- // Stil Sabitleri //
local COLORS = {
    Background = Color3.fromRGB(15, 15, 17),
    Frame = Color3.fromRGB(25, 25, 28),
    Accent = Color3.fromRGB(220, 220, 230),
    AccentDim = Color3.fromRGB(180, 180, 190),
    Text = Color3.fromRGB(240, 240, 250),
    TextDim = Color3.fromRGB(150, 150, 160),
    ToggleOn = Color3.fromRGB(220, 220, 230),
    ToggleOff = Color3.fromRGB(45, 45, 50),
    TabSelected = Color3.fromRGB(35, 35, 40),
    TabNormal = Color3.fromRGB(25, 25, 28)
}

-- // Yardımcı Fonksiyonlar //
local function createTween(instance, properties, duration)
    local tweenInfo = TweenInfo.new(duration or 0.2, Enum.EasingStyle.Quad, Enum.EasingDirection.Out)
    local tween = TweenService:Create(instance, tweenInfo, properties)
    tween:Play()
    return tween
end

local function round(num, decimal)
    local mult = 10 ^ (decimal or 0)
    return math.floor(num * mult + 0.5) / mult
end

-- // Sürüklenebilir Yapma Fonksiyonu //
local function makeDraggable(frame, dragElement)
    local dragging = false
    local dragStart = nil
    local startPos = nil
    
    dragElement = dragElement or frame
    
    dragElement.InputBegan:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
            dragging = true
            dragStart = input.Position
            startPos = frame.Position
        end
    end)
    
    dragElement.InputChanged:Connect(function(input)
        if dragging and (input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch) then
            local delta = input.Position - dragStart
            frame.Position = UDim2.new(startPos.X.Scale, startPos.X.Offset + delta.X, startPos.Y.Scale, startPos.Y.Offset + delta.Y)
        end
    end)
    
    UserInputService.InputEnded:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
            dragging = false
        end
    end)
end

