-- // Tab Sistemi //
local tabs = {}
local currentTab = nil

local function createTab(name, icon)
    local tabButton = Instance.new("TextButton")
    tabButton.Name = name
    tabButton.Size = UDim2.new(0, 120, 1, 0)
    tabButton.BackgroundColor3 = COLORS.TabNormal
    tabButton.BorderSizePixel = 0
    tabButton.Text = (icon or "") .. "  " .. name
    tabButton.TextColor3 = COLORS.TextDim
    tabButton.TextSize = 13
    tabButton.Font = Enum.Font.GothamSemibold
    tabButton.Parent = TabFrame
    
    local tabCorner = Instance.new("UICorner")
    tabCorner.CornerRadius = UDim.new(0, 4)
    tabCorner.Parent = tabButton
    
    -- İçerik Frame'i
    local tabContent = Instance.new("Frame")
    tabContent.Name = name .. "Content"
    tabContent.Size = UDim2.new(1, 0, 1, 0)
    tabContent.BackgroundTransparency = 1
    tabContent.Visible = false
    tabContent.Parent = ContentFrame
    
    -- Scrolling Frame
    local scrollFrame = Instance.new("ScrollingFrame")
    scrollFrame.Name = "Scroll"
    scrollFrame.Size = UDim2.new(1, 0, 1, 0)
    scrollFrame.BackgroundTransparency = 1
    scrollFrame.BorderSizePixel = 0
    scrollFrame.ScrollBarThickness = 3
    scrollFrame.ScrollBarImageColor3 = COLORS.AccentDim
    scrollFrame.CanvasSize = UDim2.new(0, 0, 0, 0)
    scrollFrame.Parent = tabContent
    
    local uiListLayout = Instance.new("UIListLayout")
    uiListLayout.Padding = UDim.new(0, 8)
    uiListLayout.SortOrder = Enum.SortOrder.LayoutOrder
    uiListLayout.Parent = scrollFrame
    
    local tabData = {
        button = tabButton,
        content = tabContent,
        scroll = scrollFrame,
        list = uiListLayout
    }
    
    local function selectTab()
        if currentTab == tabData then return end
        if currentTab then
            currentTab.content.Visible = false
            createTween(currentTab.button, {BackgroundColor3 = COLORS.TabNormal, TextColor3 = COLORS.TextDim}, 0.15)
        end
        tabContent.Visible = true
        createTween(tabButton, {BackgroundColor3 = COLORS.TabSelected, TextColor3 = COLORS.Accent}, 0.15)
        currentTab = tabData
    end
    
    tabButton.MouseButton1Click:Connect(selectTab)
    tabs[#tabs + 1] = tabData
    
    return tabData
end

-- // Element Oluşturucular //
local function addLabel(tab, text)
    local label = Instance.new("TextLabel")
    label.Size = UDim2.new(1, -10, 0, 20)
    label.BackgroundTransparency = 1
    label.Text = text
    label.TextColor3 = COLORS.TextDim
    label.TextSize = 12
    label.Font = Enum.Font.Gotham
    label.TextXAlignment = Enum.TextXAlignment.Left
    label.Parent = tab.scroll
    return label
end

local function addSection(tab, title)
    local section = Instance.new("Frame")
    section.Size = UDim2.new(1, -10, 0, 30)
    section.BackgroundTransparency = 1
    section.Parent = tab.scroll
    
    local sectionText = Instance.new("TextLabel")
    sectionText.Size = UDim2.new(1, 0, 1, 0)
    sectionText.BackgroundTransparency = 1
    sectionText.Text = title
    sectionText.TextColor3 = COLORS.Accent
    sectionText.TextSize = 14
    sectionText.Font = Enum.Font.GothamBold
    sectionText.TextXAlignment = Enum.TextXAlignment.Left
    sectionText.Parent = section
    
    local line = Instance.new("Frame")
    line.Size = UDim2.new(1, 0, 0, 1)
    line.Position = UDim2.new(0, 0, 1, 0)
    line.BackgroundColor3 = COLORS.Accent
    line.BackgroundTransparency = 0.7
    line.BorderSizePixel = 0
    line.Parent = section
    
    return section
end

local function addToggle(tab, title, description, default)
    local toggleFrame = Instance.new("Frame")
    toggleFrame.Size = UDim2.new(1, -10, 0, 35)
    toggleFrame.BackgroundColor3 = COLORS.Frame
    toggleFrame.BackgroundTransparency = 0.3
    toggleFrame.BorderSizePixel = 0
    toggleFrame.Parent = tab.scroll
    
    local toggleCorner = Instance.new("UICorner")
    toggleCorner.CornerRadius = UDim.new(0, 8)
    toggleCorner.Parent = toggleFrame
    
    local infoFrame = Instance.new("Frame")
    infoFrame.Size = UDim2.new(1, -60, 1, 0)
    infoFrame.BackgroundTransparency = 1
    infoFrame.Parent = toggleFrame
    
    local titleLabel = Instance.new("TextLabel")
    titleLabel.Size = UDim2.new(1, -5, 0, 18)
    titleLabel.Position = UDim2.new(0, 10, 0, 3)
    titleLabel.BackgroundTransparency = 1
    titleLabel.Text = title
    titleLabel.TextColor3 = COLORS.Text
    titleLabel.TextSize = 13
    titleLabel.Font = Enum.Font.GothamSemibold
    titleLabel.TextXAlignment = Enum.TextXAlignment.Left
    titleLabel.Parent = infoFrame
    
    local descLabel = Instance.new("TextLabel")
    descLabel.Size = UDim2.new(1, -5, 0, 12)
    descLabel.Position = UDim2.new(0, 10, 0, 20)
    descLabel.BackgroundTransparency = 1
    descLabel.Text = description
    descLabel.TextColor3 = COLORS.TextDim
    descLabel.TextSize = 10
    descLabel.Font = Enum.Font.Gotham
    descLabel.TextXAlignment = Enum.TextXAlignment.Left
    descLabel.Parent = infoFrame
    
    -- Toggle Switch
    local switch = Instance.new("TextButton")
    switch.Size = UDim2.new(0, 44, 0, 24)
    switch.Position = UDim2.new(1, -52, 0.5, -12)
    switch.BackgroundColor3 = default and COLORS.ToggleOn or COLORS.ToggleOff
    switch.BorderSizePixel = 0
    switch.Text = ""
    switch.AutoButtonColor = false
    switch.Parent = toggleFrame
    
    local switchCorner = Instance.new("UICorner")
    switchCorner.CornerRadius = UDim.new(1, 0)
    switchCorner.Parent = switch
    
    local knob = Instance.new("Frame")
    knob.Size = UDim2.new(0, 18, 0, 18)
    knob.Position = default and UDim2.new(1, -21, 0.5, -9) or UDim2.new(0, 3, 0.5, -9)
    knob.BackgroundColor3 = Color3.fromRGB(255, 255, 255)
    knob.BorderSizePixel = 0
    knob.BackgroundTransparency = 0.1
    knob.Parent = switch
    
    local knobCorner = Instance.new("UICorner")
    knobCorner.CornerRadius = UDim.new(1, 0)
    knobCorner.Parent = knob
    
    local toggled = default or false
    local callbacks = {}
    
    local function fireCallbacks(val)
        toggled = val
        for _, cb in ipairs(callbacks) do
            task.spawn(function() cb(val) end)
        end
    end
    
    switch.MouseButton1Click:Connect(function()
        toggled = not toggled
        if toggled then
            createTween(switch, {BackgroundColor3 = COLORS.ToggleOn}, 0.2)
            createTween(knob, {Position = UDim2.new(1, -21, 0.5, -9)}, 0.2)
        else
            createTween(switch, {BackgroundColor3 = COLORS.ToggleOff}, 0.2)
            createTween(knob, {Position = UDim2.new(0, 3, 0.5, -9)}, 0.2)
        end
        fireCallbacks(toggled)
    end)
    
    local obj = {}
    function obj:OnChanged(callback)
        callbacks[#callbacks + 1] = callback
        return obj
    end
    function obj:GetState()
        return toggled
    end
    function obj:SetState(value)
        toggled = value
        if toggled then
            switch.BackgroundColor3 = COLORS.ToggleOn
            knob.Position = UDim2.new(1, -21, 0.5, -9)
        else
            switch.BackgroundColor3 = COLORS.ToggleOff
            knob.Position = UDim2.new(0, 3, 0.5, -9)
        end
        fireCallbacks(toggled)
    end
    
    return obj
end

-- // GUI Aç/Kapat //
ToggleButton.MouseButton1Click:Connect(function()
    MainFrame.Visible = not MainFrame.Visible
end)

CloseButton.MouseButton1Click:Connect(function()
    MainFrame.Visible = false
end)

-- // Tabs Oluştur //
local DungeonTab = createTab("Dungeon", "🚪")
local SettingsTab = createTab("Settings", "⚙️")
local CreditsTab = createTab("Credits", "💎")

-- Varsayılan tab
currentTab = DungeonTab
DungeonTab.content.Visible = true
DungeonTab.button.BackgroundColor3 = COLORS.TabSelected
DungeonTab.button.TextColor3 = COLORS.Accent

-- // --- DUNGEON SEKME İÇERİĞİ --- //
addSection(DungeonTab, "Dungeon Otomasyonu")

local autoReplayToggle = addToggle(DungeonTab, "Auto Replay", "Dungeon bitince otomatik oy verir", false)

autoReplayToggle:OnChanged(function(value)
    if value then
        task.spawn(function()
            while autoReplayToggle:GetState() do
                pcall(function()
                    local args = { [1] = "sponsor" }
                    game:GetService("ReplicatedStorage").Remotes.DungeonWaveReplayVote:FireServer(unpack(args))
                end)
                task.wait(10)
            end
        end)
    end
end)

addLabel(DungeonTab, " ")
addSection(DungeonTab, "Yakında...")
addLabel(DungeonTab, "✨ Daha fazla özellik eklenecek")

-- // --- SETTINGS SEKME İÇERİĞİ --- //
addSection(SettingsTab, "Genel Ayarlar")

local antiAFKToggle = addToggle(SettingsTab, "Anti AFK", "Karakteri kıpırdatmadan AFK olmayı engeller", false)

task.spawn(function()
    while task.wait(10) do
        if antiAFKToggle:GetState() then
            pcall(function()
                VirtualUser:CaptureController()
                VirtualUser:ClickButton2(Vector2.new())
            end)
        end
    end
end)

addSection(SettingsTab, "Performans")

local fpsBoostToggle = addToggle(SettingsTab, "FPS Boost", "Gereksiz görselleri temizler, gölgeleri kapatır", false)

fpsBoostToggle:OnChanged(function(value)
    if value then
        for _, v in pairs(workspace:GetDescendants()) do
            if v:IsA("Texture") or v:IsA("Decal") then
                pcall(function() v:Destroy() end)
            end
        end
        local lighting = game:GetService("Lighting")
        lighting.GlobalShadows = false
        lighting.FogEnd = 9e9
        pcall(function()
            settings().Rendering.QualityLevel = 1
        end)
    end
end)

addSection(SettingsTab, "Optimizasyon")
addLabel(SettingsTab, "⚡ Daha fazla optimizasyon yakında")

-- // --- CREDITS SEKME İÇERİĞİ --- //
addSection(CreditsTab, "ZwacHub v1.0")
addLabel(CreditsTab, "Sadece işini kolaylaştırmak için yapıldı")
addLabel(CreditsTab, " ")
addLabel(CreditsTab, "💻 Developer: Zwac")
addLabel(CreditsTab, "⚡ %100 Organik Kod")
addLabel(CreditsTab, "📱 Mobil Uyumlu")
addLabel(CreditsTab, " ")
addLabel(CreditsTab, "🎯 Sailor Piece Özel")

-- Canvas size'ları güncelle
for _, tab in pairs(tabs) do
    tab.list:GetPropertyChangedSignal("AbsoluteContentSize"):Connect(function()
        tab.scroll.CanvasSize = UDim2.new(0, 0, 0, tab.list.AbsoluteContentSize.Y + 10)
    end)
end

-- // İlk sekmede canvas'ı hemen güncelle //
task.wait(0.1)
for _, tab in pairs(tabs) do
    tab.scroll.CanvasSize = UDim2.new(0, 0, 0, tab.list.AbsoluteContentSize.Y + 10)
end

-- // Başlangıç Animasyonu //
MainFrame.Size = UDim2.new(0, 0, 0, 0)
MainFrame.Visible = true
createTween(MainFrame, {Size = UDim2.new(0, 380, 0, 460)}, 0.3)
task.wait(0.3)
MainFrame.Visible = false

print("✅ ZwacHub başarıyla yüklendi! %100 Organik Kod")
