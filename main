-- // TAB SİSTEMİ //
local TabContainer = Instance.new("Frame")
TabContainer.Size = UDim2.new(0, 120, 1, -50)
TabContainer.Position = UDim2.new(0, 0, 0, 50)
TabContainer.BackgroundColor3 = C.Frame
TabContainer.BackgroundTransparency = 0.3
TabContainer.BorderSizePixel = 0
TabContainer.Parent = Main

local Content = Instance.new("Frame")
Content.Size = UDim2.new(1, -120, 1, -50)
Content.Position = UDim2.new(0, 120, 0, 50)
Content.BackgroundTransparency = 1
Content.Parent = Main

local tabs = {}
local currentTab = nil

local function CreateTab(name, icon)
    local btn = Instance.new("TextButton")
    btn.Size = UDim2.new(1, -14, 0, 38)
    btn.Position = UDim2.new(0, 7, 0, 12 + (#tabs * 48))
    btn.BackgroundColor3 = (#tabs == 0) and C.TabActive or C.TabInactive
    btn.BackgroundTransparency = (#tabs == 0) and 0.1 or 0
    btn.BorderSizePixel = 0
    btn.Text = icon .. "  " .. name
    btn.TextColor3 = (#tabs == 0) and Color3.fromRGB(20, 20, 22) or C.Text
    btn.TextSize = 13
    btn.Font = Enum.Font.GothamSemibold
    btn.AutoButtonColor = false
    btn.Parent = TabContainer

    local BtnCorner = Instance.new("UICorner")
    BtnCorner.CornerRadius = UDim.new(0, 8)
    BtnCorner.Parent = btn

    local contentFrame = Instance.new("ScrollingFrame")
    contentFrame.Size = UDim2.new(1, -20, 1, -20)
    contentFrame.Position = UDim2.new(0, 10, 0, 10)
    contentFrame.BackgroundTransparency = 1
    contentFrame.BorderSizePixel = 0
    contentFrame.ScrollBarThickness = 2
    contentFrame.ScrollBarImageColor3 = C.Accent
    contentFrame.CanvasSize = UDim2.new(0, 0, 0, 0)
    contentFrame.Visible = (#tabs == 0)
    contentFrame.Parent = Content

    local list = Instance.new("UIListLayout")
    list.Padding = UDim.new(0, 10)
    list.SortOrder = Enum.SortOrder.LayoutOrder
    list.Parent = contentFrame

    list:GetPropertyChangedSignal("AbsoluteContentSize"):Connect(function()
        contentFrame.CanvasSize = UDim2.new(0, 0, 0, list.AbsoluteContentSize.Y + 20)
    end)

    local tabData = { button = btn, content = contentFrame, list = list }

    btn.MouseButton1Click:Connect(function()
        if currentTab == tabData then return end
        if currentTab then
            currentTab.content.Visible = false
            currentTab.button.BackgroundColor3 = C.TabInactive
            currentTab.button.BackgroundTransparency = 0
            currentTab.button.TextColor3 = C.Text
        end
        contentFrame.Visible = true
        btn.BackgroundColor3 = C.TabActive
        btn.BackgroundTransparency = 0.1
        btn.TextColor3 = Color3.fromRGB(20, 20, 22)
        currentTab = tabData
        task.wait(0.05)
        contentFrame.CanvasSize = UDim2.new(0, 0, 0, list.AbsoluteContentSize.Y + 20)
    end)

    tabs[#tabs + 1] = tabData
    if #tabs == 1 then currentTab = tabData end

    return {
        scroll = contentFrame,
        list = list,
        button = btn
    }
end

-- // Element Oluşturucular //
local function AddSection(tab, title)
    local section = Instance.new("Frame")
    section.Size = UDim2.new(1, 0, 0, 26)
    section.BackgroundTransparency = 1
    section.Parent = tab.scroll

    local text = Instance.new("TextLabel")
    text.Size = UDim2.new(1, 0, 1, 0)
    text.BackgroundTransparency = 1
    text.Text = title
    text.TextColor3 = C.Accent
    text.TextSize = 12
    text.Font = Enum.Font.GothamBold
    text.TextXAlignment = Enum.TextXAlignment.Left
    text.Parent = section

    local line = Instance.new("Frame")
    line.Size = UDim2.new(1, 0, 0, 1)
    line.Position = UDim2.new(0, 0, 1, 0)
    line.BackgroundColor3 = C.Accent
    line.BackgroundTransparency = 0.8
    line.BorderSizePixel = 0
    line.Parent = section

    return section
end

local function AddLabel(tab, text)
    local lbl = Instance.new("TextLabel")
    lbl.Size = UDim2.new(1, 0, 0, 16)
    lbl.BackgroundTransparency = 1
    lbl.Text = text
    lbl.TextColor3 = C.TextDim
    lbl.TextSize = 11
    lbl.Font = Enum.Font.Gotham
    lbl.TextXAlignment = Enum.TextXAlignment.Left
    lbl.Parent = tab.scroll
    return lbl
end

local function AddToggle(tab, title, desc, default)
    local frame = Instance.new("Frame")
    frame.Size = UDim2.new(1, 0, 0, 50)
    frame.BackgroundColor3 = C.Frame
    frame.BackgroundTransparency = 0.5
    frame.BorderSizePixel = 0
    frame.Parent = tab.scroll

    local fCorner = Instance.new("UICorner")
    fCorner.CornerRadius = UDim.new(0, 8)
    fCorner.Parent = frame

    local titleLbl = Instance.new("TextLabel")
    titleLbl.Size = UDim2.new(1, -60, 0, 20)
    titleLbl.Position = UDim2.new(0, 12, 0, 6)
    titleLbl.BackgroundTransparency = 1
    titleLbl.Text = title
    titleLbl.TextColor3 = C.Text
    titleLbl.TextSize = 12
    titleLbl.Font = Enum.Font.GothamSemibold
    titleLbl.TextXAlignment = Enum.TextXAlignment.Left
    titleLbl.Parent = frame

    local descLbl = Instance.new("TextLabel")
    descLbl.Size = UDim2.new(1, -60, 0, 14)
    descLbl.Position = UDim2.new(0, 12, 0, 28)
    descLbl.BackgroundTransparency = 1
    descLbl.Text = desc
    descLbl.TextColor3 = C.TextDim
    descLbl.TextSize = 10
    descLbl.Font = Enum.Font.Gotham
    descLbl.TextXAlignment = Enum.TextXAlignment.Left
    descLbl.Parent = frame

    local switch = Instance.new("TextButton")
    switch.Size = UDim2.new(0, 44, 0, 24)
    switch.Position = UDim2.new(1, -56, 0, 13)
    switch.BackgroundColor3 = default and C.SwitchOn or C.SwitchOff
    switch.BorderSizePixel = 0
    switch.Text = ""
    switch.AutoButtonColor = false
    switch.Parent = frame

    local sCorner = Instance.new("UICorner")
    sCorner.CornerRadius = UDim.new(1, 0)
    sCorner.Parent = switch

    local knob = Instance.new("Frame")
    knob.Size = UDim2.new(0, 18, 0, 18)
    knob.Position = default and UDim2.new(1, -21, 0.5, -9) or UDim2.new(0, 3, 0.5, -9)
    knob.BackgroundColor3 = Color3.fromRGB(255, 255, 255)
    knob.BackgroundTransparency = 0.1
    knob.BorderSizePixel = 0
    knob.Parent = switch

    local kCorner = Instance.new("UICorner")
    kCorner.CornerRadius = UDim.new(1, 0)
    kCorner.Parent = knob

    local toggled = default or false
    local callbacks = {}

    local function fire(val)
        toggled = val
        for _, cb in ipairs(callbacks) do
            task.spawn(function() cb(val) end)
        end
    end

    switch.MouseButton1Click:Connect(function()
        toggled = not toggled
        if toggled then
            Tween(switch, {BackgroundColor3 = C.SwitchOn}, 0.2)
            Tween(knob, {Position = UDim2.new(1, -21, 0.5, -9)}, 0.2)
        else
            Tween(switch, {BackgroundColor3 = C.SwitchOff}, 0.2)
            Tween(knob, {Position = UDim2.new(0, 3, 0.5, -9)}, 0.2)
        end
        fire(toggled)
    end)

    return {
        OnChanged = function(self, cb)
            callbacks[#callbacks + 1] = cb
            return self
        end,
        GetState = function()
            return toggled
        end,
        SetState = function(val)
            toggled = val
            switch.BackgroundColor3 = val and C.SwitchOn or C.SwitchOff
            knob.Position = val and UDim2.new(1, -21, 0.5, -9) or UDim2.new(0, 3, 0.5, -9)
        end
    }
end

local function AddButton(tab, title, callback)
    local btn = Instance.new("TextButton")
    btn.Size = UDim2.new(1, 0, 0, 35)
    btn.BackgroundColor3 = C.Frame
    btn.BackgroundTransparency = 0.5
    btn.BorderSizePixel = 0
    btn.Text = title
    btn.TextColor3 = C.Text
    btn.TextSize = 13
    btn.Font = Enum.Font.GothamSemibold
    btn.Parent = tab.scroll

    local btnCorner = Instance.new("UICorner")
    btnCorner.CornerRadius = UDim.new(0, 8)
    btnCorner.Parent = btn

    btn.MouseButton1Click:Connect(callback)
    return btn
end

-- // GUI AÇ/KAPAT //
ToggleBtn.MouseButton1Click:Connect(function()
    Main.Visible = not Main.Visible
end)

Close.MouseButton1Click:Connect(function()
    Main.Visible = false
end)

-- // ==================== SEKMELER ==================== //
local GameTab = CreateTab("Game", "🎮")
local SettingsTab = CreateTab("Settings", "⚙️")

-- // --- GAME SEKME - DUNGEON --- //
AddSection(GameTab, "Dungeon Otomasyonu")
local autoReplay = AddToggle(GameTab, "Auto Replay", "Her 10 saniyede bir Replay eventini atar", false)

autoReplay:OnChanged(function(val)
    if val then
        task.spawn(function()
            while autoReplay:GetState() do
                pcall(function()
                    local args = { [1] = "sponsor" }
                    game:GetService("ReplicatedStorage").Remotes.DungeonWaveReplayVote:FireServer(unpack(args))
                end)
                task.wait(10)
            end
        end)
    end
end)

-- // --- GAME SEKME - AUTO SKILL --- //
AddSection(GameTab, "Auto Skill")
local autoSkill = AddToggle(GameTab, "Auto Skill", "Z-X-C-V-F tuşlarını sırayla otomatik atar", false)
local skillLabel = AddLabel(GameTab, "⏸️ Auto Skill pasif")

autoSkill:OnChanged(function(val)
    if val then
        skillLabel.Text = "⚔️ Auto Skill aktif - Z-X-C-V-F"
        task.spawn(function()
            while autoSkill:GetState() do
                local keys = {Enum.KeyCode.Z, Enum.KeyCode.X, Enum.KeyCode.C, Enum.KeyCode.V, Enum.KeyCode.F}
                for _, key in ipairs(keys) do
                    if not autoSkill:GetState() then break end
                    pcall(function()
                        VirtualInputService:SendKeyEvent(true, key, false, game)
                        task.wait(0.05)
                        VirtualInputService:SendKeyEvent(false, key, false, game)
                    end)
                    task.wait(0.3)
                end
            end
        end)
    else
        skillLabel.Text = "⏸️ Auto Skill pasif"
    end
end)

-- // --- GAME SEKME - BOSS FARM --- //
AddSection(GameTab, "Boss Farm")
AddLabel(GameTab, "📍 NPC Konumu: Kaydedilmedi")

local npcPosLabel = AddLabel(GameTab, "NPC: Yok")
npcPosLabel.Size = UDim2.new(1, 0, 0, 20)

local savedNpcPos = nil

AddButton(GameTab, "💾 NPC Konumunu Kaydet", function()
    if Player.Character and Player.Character:FindFirstChild("HumanoidRootPart") then
        savedNpcPos = Player.Character.HumanoidRootPart.Position
        npcPosLabel.Text = "📍 NPC: " .. math.floor(savedNpcPos.X) .. ", " .. math.floor(savedNpcPos.Y) .. ", " .. math.floor(savedNpcPos.Z)
    end
end)

local bossToggles = {}
local bossStatusLabel = AddLabel(GameTab, "⏳ Boss bekleniyor...")
bossStatusLabel.Size = UDim2.new(1, 0, 0, 20)

local killCounters = {
    ["Sun God"] = 0,
    ["Cosmic Being"] = 0
}
local killLabel = AddLabel(GameTab, "💀 Kill: Sun God 0 | Cosmic Being 0")
killLabel.Size = UDim2.new(1, 0, 0, 20)

-- Boss Toggle'larını oluştur
for bossName, data in pairs(BOSS_DATA) do
    local toggle = AddToggle(GameTab, bossName, "Otomatik " .. bossName .. " keser", false)
    bossToggles[bossName] = toggle

    toggle:OnChanged(function(val)
        if val then
            if not savedNpcPos then
                toggle:SetState(false)
                bossStatusLabel.Text = "❌ Önce NPC konumu kaydet!"
                return
            end
            bossStatusLabel.Text = "🔍 " .. bossName .. " taranıyor..."
            task.spawn(function()
                while toggle:GetState() do
                    -- Boss modelini kontrol et
                    local pathParts = data.path:split(".")
                    local current = workspace
                    local exists = true
                    for _, part in ipairs(pathParts) do
                        if current and current:FindFirstChild(part) then
                            current = current[part]
                        else
                            exists = false
                            break
                        end
                    end

                    if exists then
                        bossStatusLabel.Text = "⚔️ " .. bossName .. " bulundu, saldırılıyor!"
                        -- Işınlan
                        if Player.Character and Player.Character:FindFirstChild("HumanoidRootPart") then
                            Player.Character.HumanoidRootPart.CFrame = CFrame.new(data.pos)
                        end

                        -- Boss yok olana kadar bekle
                        local bossAlive = true
                        while bossAlive and toggle:GetState() do
                            task.wait(0.2)

                            -- Boss kontrolü
                            local checkCurrent = workspace
                            local stillExists = true
                            for _, part in ipairs(pathParts) do
                                if checkCurrent and checkCurrent:FindFirstChild(part) then
                                    checkCurrent = checkCurrent[part]
                                else
                                    stillExists = false
                                    break
                                end
                            end

                            if not stillExists then
                                bossAlive = false
                                break
                            end

                            -- Knockback koruması
                            if Player.Character and Player.Character:FindFirstChild("HumanoidRootPart") then
                                local dist = (Player.Character.HumanoidRootPart.Position - data.pos).Magnitude
                                if dist > 2 then
                                    pcall(function()
                                        Player.Character.HumanoidRootPart.CFrame = CFrame.new(data.pos)
                                    end)
                                    bossStatusLabel.Text = "🔄 " .. bossName .. " knockback önlendi!"
                                end
                            end
                        end

                        -- Boss öldü
                        killCounters[bossName] = killCounters[bossName] + 1
                        killLabel.Text = "💀 Kill: Sun God " .. killCounters["Sun God"] .. " | Cosmic Being " .. killCounters["Cosmic Being"]
                        bossStatusLabel.Text = "✅ " .. bossName .. " öldü, NPC'ye dönülüyor..."

                        -- Geri dön
                        if savedNpcPos and Player.Character and Player.Character:FindFirstChild("HumanoidRootPart") then
                            Player.Character.HumanoidRootPart.CFrame = CFrame.new(savedNpcPos)
                        end
                        bossStatusLabel.Text = "🔍 " .. bossName .. " taranıyor..."
                    end
                    task.wait(1)
                end
            end)
        else
            bossStatusLabel.Text = "⏸️ " .. bossName .. " durduruldu"
        end
    end)
end

-- // --- SETTINGS SEKME --- //
AddSection(SettingsTab, "Genel (Otomatik Açık)")
local antiAFK = AddToggle(SettingsTab, "Anti AFK", "Kıpırdamadan AFK engeller", true)
local fpsBoost = AddToggle(SettingsTab, "FPS Boost", "Gereksiz texture temizliği", true)
local lowGraphics = AddToggle(SettingsTab, "Low Graphics", "Işık/gölge kapat, performans", true)

-- Anti Knockback (Manuel CFrame Kilitleme)
AddSection(SettingsTab, "Karakter")
local antiKB = AddToggle(SettingsTab, "Anti Knockback", "Karakteri sabitler, knockback yemezsin", false)
local kbSavedPos = nil

antiKB:OnChanged(function(val)
    if val then
        if Player.Character and Player.Character:FindFirstChild("HumanoidRootPart") then
            kbSavedPos = Player.Character.HumanoidRootPart.Position
        end
        task.spawn(function()
            while antiKB:GetState() do
                if Player.Character and Player.Character:FindFirstChild("HumanoidRootPart") and kbSavedPos then
                    local dist = (Player.Character.HumanoidRootPart.Position - kbSavedPos).Magnitude
                    if dist > 0.5 then
                        pcall(function()
                            Player.Character.HumanoidRootPart.CFrame = CFrame.new(kbSavedPos)
                        end)
                    end
                else
                    if Player.Character and Player.Character:FindFirstChild("HumanoidRootPart") then
                        kbSavedPos = Player.Character.HumanoidRootPart.Position
                    end
                end
                task.wait(0.1)
            end
        end)
    end
end)

-- Anti AFK döngüsü
task.spawn(function()
    while task.wait(10) do
        if antiAFK:GetState() then
            pcall(function()
                VirtualUser:CaptureController()
                VirtualUser:ClickButton2(Vector2.new())
            end)
        end
    end
end)

-- FPS Boost ve Low Graphics uygula
task.spawn(function()
    -- FPS Boost başlangıç
    for _, v in pairs(workspace:GetDescendants()) do
        if v:IsA("Texture") or v:IsA("Decal") then
            pcall(function() v:Destroy() end)
        end
    end
    if fpsBoost:GetState() then
        Lighting.GlobalShadows = false
        Lighting.FogEnd = 9e9
        pcall(function() settings().Rendering.QualityLevel = 1 end)
    end
    if lowGraphics:GetState() then
        Lighting.GlobalShadows = false
        Lighting.FogEnd = 9e9
        Lighting.Brightness = 1
        Lighting.ClockTime = 14
        pcall(function()
            settings().Rendering.QualityLevel = 1
            settings().Rendering.MeshPartDetailLevel = Enum.MeshPartDetailLevel.Level03
        end)
    end
end)

-- // Canvas Güncelle //
for _, tab in pairs(tabs) do
    task.wait(0.05)
    tab.content.CanvasSize = UDim2.new(0, 0, 0, tab.list.AbsoluteContentSize.Y + 20)
end

-- // Açılış Animasyonu //
Main.Size = UDim2.new(0, 500, 0, 0)
Main.Visible = true
Tween(Main, {Size = UDim2.new(0, 500, 0, 350)}, 0.3)
task.wait(0.3)
Main.Visible = false

print("✅ ZwacHub v3.5 Yüklendi - Tüm özellikler aktif")
print("🎮 Geliştirici: Zwac | %100 Organik Kod")
print("🖼️ Logo eklendi | ⚔️ Auto Skill | 🛡️ Anti Knockback | 👾 Çift Boss Farm")
